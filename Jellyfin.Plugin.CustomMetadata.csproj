<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.CustomMetadata</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.CustomMetadata</RootNamespace>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Plugin version (shown by Jellyfin). CI replaces it with the Git tag's version: -p:Version=1.2.3 -->
    <Version>0.0.8</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin dependencies - ExcludeAssets runtime as per official template -->
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    
    <!-- SkiaSharp: provided by the Jellyfin server (12.4 → 3.119.4). Exactly the server's version,
         not shipped with the plugin (ExcludeAssets runtime): used by the image converters (portrait thumbs, landscape posters) -->
    <PackageReference Include="SkiaSharp" Version="3.119.4">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core: the plugin's API controllers (provided by Jellyfin at runtime) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuration web page -->
    <EmbeddedResource Include="Configuration\*.html" />
    <!-- Projection web theme, served by Api/ThemeController (CustomMetadata/Theme/projection.css, projection.js, projection-index.js) -->
    <EmbeddedResource Include="theme\projection.css" LogicalName="Jellyfin.Plugin.CustomMetadata.theme.projection.css" />
    <EmbeddedResource Include="theme\projection.js" LogicalName="Jellyfin.Plugin.CustomMetadata.theme.projection.js" />
    <EmbeddedResource Include="theme\projection-index.js" LogicalName="Jellyfin.Plugin.CustomMetadata.theme.projection-index.js" />
    <EmbeddedResource Include="theme\projection-photos.js" LogicalName="Jellyfin.Plugin.CustomMetadata.theme.projection-photos.js" />
    <!-- Episode photo gallery script, served by Api/PhotosController (CustomMetadata/Photos/gallery.js) -->
    <EmbeddedResource Include="web\gallery.js" LogicalName="Jellyfin.Plugin.CustomMetadata.web.gallery.js" />
  </ItemGroup>

</Project>
