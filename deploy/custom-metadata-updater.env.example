# Copy to /etc/custom-metadata-updater.env (chmod 600) and adapt.

# GitHub repository that publishes the releases: "owner/repository"
GITHUB_REPO=owner/repository

# Defaults of a Debian/Ubuntu installation of the jellyfin package (change only if needed)
#PLUGIN_DIR=/var/lib/jellyfin/plugins/CustomMetadata
#CONFIG_XML=/var/lib/jellyfin/plugins/configurations/Jellyfin.Plugin.CustomMetadata.xml
#JELLYFIN_SERVICE=jellyfin
#JELLYFIN_URL=http://127.0.0.1:8096
#JELLYFIN_USER=jellyfin
#JELLYFIN_GROUP=jellyfin

# 1 = only report (in the journal) that an update exists, without installing it: you run it yourself with
# "sudo custom-metadata-updater.sh". Recommended if you prefer to validate each version.
#NOTIFY_ONLY=0

#HEALTH_TIMEOUT=120
#KEEP_BACKUPS=5
